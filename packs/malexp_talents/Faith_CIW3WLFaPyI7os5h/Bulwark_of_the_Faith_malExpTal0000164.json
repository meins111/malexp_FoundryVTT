          {
            "label": "Bulwark of the Faith: damage Daemon on resisted Fear",
            "trigger": "rollSkillTest",
            "script": "\n    let context = JSON.stringify(args.context || {}).toLowerCase();\n    if (args.result?.outcome !== 'success' || !context.includes('fear') || !context.includes('daemon')) return;\n    let damage = Math.max(0, args.result.SL || 0);\n    let target = args.context.sourceActor || args.context.source?.actor || args.context.opposed?.attackerTest?.actor;\n    if (target?.applyDamage) {\n        target.applyDamage(damage, {ignoreAP: true, message: true});\n    } else {\n        ChatMessage.create({content: '<p>Bulwark of the Faith: resisted Daemon Fear; damage to source: ' + damage + '.</p>'});\n    }\n  ",
