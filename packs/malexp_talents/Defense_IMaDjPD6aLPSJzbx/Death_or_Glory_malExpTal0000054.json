            "script": "\n    let context = JSON.stringify(args.context || {}).toLowerCase();\n    if (!context.includes('fear')) return;\n    let charge = await foundry.applications.api.Dialog.confirm({\n        window: {title: 'Death or Glory'},\n        content: '<p>Charge the source of this Fear test instead?</p>'\n    });\n    if (charge) {\n        await args.actor.update({'system.combat.action': 'charge'});\n        args.context.deathOrGlory = true;\n    }\n  ",
