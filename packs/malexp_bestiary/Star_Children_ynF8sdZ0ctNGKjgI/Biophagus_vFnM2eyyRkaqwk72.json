    {
      "name": "Twisted Scientist",
      "type": "trait",
      "_id": "srwKZN8b55thM7mF",
      "img": "modules/impmal-core/assets/icons/blank.webp",
      "system": {
        "notes": {
         "player": "",
          "gm": "<p>The Biophagus counts as having the Chirurgeon Talent, and gains +2SL whenever concocting new poisons or healing Genestealer Cults creatures. Additionally, as an Action on their turn, the Biophagus can use their Injector Goad on a Genestealer Cult ally within Immediate Range, dosing them with a gene-brew that enhances their abilities. Roll 1d10: 1-2 Heightened Senses (Advantage to Awareness, Intuition, Reflexes); 3-4 Regenerating Mass (heal Toughness Bonus Wounds at start of turn); 5-6 Hulking Frame (+Toughness Bonus Wounds, +Strength Bonus SL to Strength Tests and Melee Damage); 7-8 Carapaced Flesh (+2 Armour); 9-0 Combat Instincts (Advantage to Discipline, Melee, Ranged, Stealth). Each character can only be affected by this Trait once per encounter.</p>"
        },
