      "img": "modules/impmal-core/assets/icons/blank.webp",
      "system": {
        "notes": {
          "player": "<p>The Hybrid Metamorph has at least one other mutation, but may have any other reasonable mutation from the Tyranid genome. Roll 1d10: 1-2 Metamorph Whip (unarmed attacks gain Reach and Inflict (Restrained)); 3-4 Metamorph Talon (unarmed attacks gain Rend (1) and lose Ineffective); 5-6 Metamorph Claw (unarmed attacks gain Penetrating (2)); 7-8 Metamorph Acid (Ranged attack, 3 + SL Difference Damage, Medium Range, Close, Inflict (Poisoned), Penetrating (2)); 9-10 Tyranid Caricature (Advantage on Presence (Intimidation) tests).</p>",
          "gm": ""
        },
